// Archipelago — one slide cut into four habitats.
//
// Two walls, each with a narrow gap, divide a 96x96 world into quadrants that exchange only
// through those gaps. M8's first acceptance test compares speciation here against
// `archipelago_control.ron`, which is this scenario with the walls taken out and nothing else
// changed.
//
// That pairing is the point. "Populations diverge faster when separated" is only a claim if
// there is something to be faster *than*, and the control has to differ in exactly one thing
// or the comparison measures whatever else moved.
//
// The gaps are deliberately not zero. A slide cut into four sealed boxes is four separate
// runs sharing a file, and allopatric speciation is interesting because the barrier is
// leaky — divergence has to outrun the trickle of migrants that would otherwise homogenise it.
//
//   mm-cli run scenarios/archipelago.ron --genome genomes/ancestor.mm --ticks 500000 --archive islands.ndjson
(
    name: "archipelago",
    seed: 20250804,
    width: 96,
    height: 96,

    light: Uniform(intensity: 1024),
    current: Still,
    fluid_interval: 1,

    seeding: [
        Uniform(chemical: 11, per_square: 409600),
        // The carbonate system (`docs/CHEMISTRY.md` §11). Carbonate matched to the dissolved
        // CO2 above, so the slide starts at pH 7 and every move from there is something the
        // cells did. Calcium is then *not* free: the pair precipitates on the product of the
        // two, so this is set to put `sqrt(calcium * carbonate)` a little over
        // `minerals.calcite_saturation` — near enough to equilibrium that the pH decides which
        // way it goes, which is the whole point of the coupling.
        Uniform(chemical: 18, per_square: 409600),
        Uniform(chemical: 17, per_square: 3461),
        Uniform(chemical: 14, per_square: 409600),
        Uniform(chemical: 4, per_square: 409600),
        // The three minerals nothing in the engine produces (`docs/CHEMISTRY.md` §8): seeding is
        // the only way in, and without them a nucleus, an enzyme or a shell cannot be built at
        // all. At the Redfield proportion of this world's own carbon — 16/106 nitrogen, 1/106
        // phosphorus rounded up — and half that again in silicon, matching the fresh slide.
        Uniform(chemical: 5, per_square: 61440),
        Uniform(chemical: 6, per_square: 4096),
        // The inert pool a diazosome cracks. Four times the bioavailable nitrogen: a
        // young world is mostly locked up, and unlocking it is what the organelle is for.
        Uniform(chemical: 16, per_square: 245760),
        Uniform(chemical: 7, per_square: 20480),
    ],

    barriers: [
        WallWithGap(at: 48, vertical: true, gap_start: 46, gap_len: 4),
        WallWithGap(at: 48, vertical: false, gap_start: 46, gap_len: 4),
    ],
)
