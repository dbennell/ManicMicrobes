// Photosynthesis or die — a world with nothing dissolved in it.
//
// The soup has carbon dioxide, an oxidant and carbon lying about, so a cell can live on what
// it finds. Here there is almost none of any of it: what there is arrives as light, and a
// lineage without chloroplasts has no second way to pay its upkeep.
//
// The point is not that photosynthesis wins — it is that the *cost* of a chloroplast is being
// weighed against something. A scenario where every strategy works measures nothing.
//
//   mm-cli run scenarios/photosynthesis_or_die.ron --genome genomes/ancestor.mm --ticks 100000
(
    name: "photosynthesis or die",
    seed: 20250801,
    width: 64,
    height: 64,

    // Bright and unvarying, so the only gradient is the one between having a chloroplast and
    // not having one.
    light: Uniform(intensity: 1536),
    current: Still,
    fluid_interval: 1,

    // A tenth of the soup's chemistry. Enough to get started and not enough to live on.
    seeding: [
        Uniform(chemical: 11, per_square: 40960),
        // The carbonate system (`docs/CHEMISTRY.md` §11). Carbonate matched to the dissolved
        // CO2 above, so the slide starts at pH 7 and every move from there is something the
        // cells did; calcium at half that, which is a reef's worth of the other half.
        Uniform(chemical: 18, per_square: 40960),
        Uniform(chemical: 17, per_square: 20480),
        Uniform(chemical: 14, per_square: 40960),
        Uniform(chemical: 4, per_square: 61440),
        // The three minerals nothing in the engine produces (`docs/CHEMISTRY.md` §8): seeding is
        // the only way in, and without them a nucleus, an enzyme or a shell cannot be built at
        // all. At the Redfield proportion of this world's own carbon — 16/106 nitrogen, 1/106
        // phosphorus rounded up — and half that again in silicon, matching the fresh slide.
        Uniform(chemical: 5, per_square: 9216),
        Uniform(chemical: 6, per_square: 1024),
        // The inert pool a diazosome cracks. Four times the bioavailable nitrogen: a
        // young world is mostly locked up, and unlocking it is what the organelle is for.
        Uniform(chemical: 16, per_square: 36864),
        Uniform(chemical: 7, per_square: 30720),
    ],
    barriers: [],
)
