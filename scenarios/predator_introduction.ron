// Predator introduction — a well-fed world for something to eat something else in.
//
// Nothing here makes a predator. The scenario supplies what predation needs to be *possible*:
// plenty of prey, room to chase them across, and a slide big enough that a predator cannot
// simply exhaust it. Whether anything picks up a spike is up to the run.
//
// M8's second acceptance test looks for a predator-prey oscillation here. Seed it with a
// hand-written hunter alongside the ancestor to watch one deliberately, or leave it to
// mutation and find out how long it takes.
//
//   mm-cli match genomes/ancestor.mm genomes/hunter.mm
//   mm-cli run scenarios/predator_introduction.ron --genome genomes/ancestor.mm --ticks 1000000
(
    name: "predator introduction",
    seed: 20250803,
    width: 128,
    height: 128,

    light: Uniform(intensity: 1024),
    // A slow stir, so prey are not evenly spread and a hunter has somewhere worth being.
    current: Rotational(strength: 96),
    fluid_interval: 1,

    seeding: [
        Uniform(chemical: 11, per_square: 409600),
        Uniform(chemical: 14, per_square: 409600),
        Uniform(chemical: 4, per_square: 409600),
        // The three minerals nothing in the engine produces (`docs/CHEMISTRY.md` §8): seeding is
        // the only way in, and without them a nucleus, an enzyme or a shell cannot be built at
        // all. At the Redfield proportion of this world's own carbon — 16/106 nitrogen, 1/106
        // phosphorus rounded up — and half that again in silicon, matching the fresh slide.
        Uniform(chemical: 5, per_square: 61440),
        Uniform(chemical: 6, per_square: 4096),
        // The inert pool a diazosome cracks. Four times the bioavailable nitrogen: a
        // young world is mostly locked up, and unlocking it is what the organelle is for.
        Uniform(chemical: 16, per_square: 245760),
        Uniform(chemical: 7, per_square: 204800),
    ],
    barriers: [],
)
