// The drift — a channel with particulate flowing down it.
//
// The slide filter feeding was built for, and the one place on the shelf where staying still is
// a way to make a living. Two walls make a channel, a gentle uniform current runs along it, and
// the water carries detritus: a chemical that advects at a third of the water's speed, so it
// lags the flow, piles up against obstructions and does not simply arrive everywhere at once
// the way a dissolved pool does.
//
// What makes this different from every other scenario is that food *goes past*. Everywhere else
// a cell's next meal is in the square it is standing in, so position is worth nothing and
// nothing has ever evolved to hold one. Here what a cell can take is what flows by it, which is
// zero if it is drifting along with the water — so the holdfast is worth its upkeep and
// `genomes/sponge.mm` is worth trying against `genomes/drifter.mm`:
//
//   mm-cli run scenarios/the_drift.ron --ticks 50000 --check
//
// No `--genome` needed: the slide says who lives on it. Pass one anyway to override, which is
// the way to ask what some other strategy makes of a channel.
//
// It is a flow-through slide rather than a closed one: detritus arrives at the upstream end and
// whatever reaches the downstream end leaves. That pairing is the point. A source without a
// drain is a slow count up to the quantity cap, and a population under a ceiling set by
// arithmetic is not a population under a carrying capacity — with both, the standing stock finds
// a level, and the level is a thing the sponges are competing over.
(
    name: "the drift",
    seed: 20260802,
    width: 96,
    height: 96,

    // Lit, because a sponge that could not photosynthesise would starve waiting for its first
    // grain. The filter is a second income, not a replacement for the first.
    light: Uniform(intensity: 1024),

    // Gentle: an eighth of a square per step. Fast enough that a cell holding station has real
    // water going past it, slow enough that a cell which lets go is not immediately at the far
    // wall. Speed is most of what decides whether filtering pays, so this is the number to move
    // first when asking whether it does.
    current: Uniform(vx: 128, vy: 0),
    fluid_interval: 1,

    seeding: [
        // The ordinary chemistry of being alive: something to fix, something to breathe,
        // something to build a body from.
        Uniform(chemical: 11, per_square: 409600),
        Uniform(chemical: 14, per_square: 409600),
        Uniform(chemical: 4, per_square: 204800),
        // The three minerals nothing in the engine produces (`docs/CHEMISTRY.md` §8): seeding is
        // the only way in, and without them a nucleus, an enzyme or a shell cannot be built at
        // all. At the Redfield proportion of this world's own carbon — 16/106 nitrogen, 1/106
        // phosphorus rounded up — and half that again in silicon, matching the fresh slide.
        Uniform(chemical: 5, per_square: 30720),
        Uniform(chemical: 6, per_square: 2048),
        // The inert pool a diazosome cracks. Four times the bioavailable nitrogen: a
        // young world is mostly locked up, and unlocking it is what the organelle is for.
        Uniform(chemical: 16, per_square: 122880),
        Uniform(chemical: 7, per_square: 102400),

        // The particulate. Half what the dissolved chemicals get, because it is meant to be
        // worth catching rather than unavoidable. This is only the starting charge — the
        // channel is fed continuously from `flux` below.
        Uniform(chemical: 12, per_square: 102400),
    ],

    // The supply, and the drain that keeps it from becoming a pile.
    //
    // Detritus enters in a column two squares wide at the upstream end and leaves through the
    // last six, at a rate rather than an amount so the outflow can never scour the channel dry
    // and settles into balance with whatever reaches it instead.
    //
    // The outflow is wider than the inlet on purpose. Detritus advects at a third of the water's
    // speed, so it arrives at the far wall more slowly than the water does and would bank up
    // against it — which looks like an interesting gradient and is really a boundary condition.
    flux: [
        Source(chemical: 12, x: 0, y: 34, width: 2, height: 28, per_tick: 6000),
        Drain(chemical: 12, x: 90, y: 0, width: 6, height: 96, rate: 128),
    ],

    // Sponges, because that is what this slide is for — `sponge.mm` builds a holdfast and no
    // cilia, so where it lands is where it lives.
    //
    // Sixteen, along the inside of the upper wall, which is the only place a sponge can work: a
    // holdfast grips a *barrier*, and a founder in open water has nothing to hold and drifts away
    // with the current like everything else.
    //
    // This used to read "twelve rather than sixteen: the founders are spread over a square grid
    // and a channel is not square, so some of them would land in the walls" — a scenario author
    // reducing the population to work around the placement rule. `Placement` is that rule fixed;
    // the count is back to sixteen and every one of them starts against the wall it needs.
    inhabitants: [
        (
            genome: "sponge.mm",
            count: 16,
            place: Grid(x: 8, y: 34, width: 80, height: 1),
        ),
    ],

    // The channel: two walls thirty-two squares apart, open at both ends so the current runs
    // through rather than into them.
    barriers: [
        Rect(x: 6, y: 32, width: 84, height: 2),
        Rect(x: 6, y: 62, width: 84, height: 2),
    ],
)
